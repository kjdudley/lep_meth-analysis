#!/bin/bash
#PBS -N caddis_meth
#PBS -q cpu_batch
#PBS -l select=1:ncpus=32:mem=96gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /work/cyberomics/lep_meth/molanna/logs/
#PBS -V
#
#   qsub -v SP=ceraclea,RUN=ERR12085120,ACC=GCA_963576895,\
#           BAM=m64222e_230923_052505.hifi_reads.bc2048--bc2048.bam \
#        pipeline/scripts/caddis_methyl.pbs
#
# Generalised from molanna_methyl.pbs. Measures a caddisfly methylome and
# nothing else: no annotation is needed for the readouts that decide whether
# the species is usable.
#
# WHY THE METHYLOME COMES FIRST NOW (2026-09-15). Molanna's motif analysis
# returned no positional signature at all, just a flat C/G preference at every
# flanking position. The reason appears to be abundance: 11.91% of its CpGs
# are above 50% methylation, against 0.35% in Xylocopa. When an eighth of a
# genome's CpGs are heavily methylated, the methylated set approaches a
# compositional sample of gene-body CpGs and any enzyme preference washes out.
# A flanking signature is only visible where methylation is SELECTIVE.
#
# So the gate is sparseness, and it is cheap to measure. Run the motif
# analysis on a species only if its methylome is sparse. If Trichoptera as an
# order carry abundant methylomes, the flanking test cannot be run in this
# order at all, and that is worth knowing before building an annotation --
# especially for species with no RNA, which need the untested miniprot route.
#
# THE TAG CHECK IS DONE REMOTELY, BEFORE THE DOWNLOAD. samtools here is built
# with libcurl, so the header and first reads stream from ENA in about a
# minute. A deposit without primrose 5mC calls is then rejected without
# pulling 21 GB. "PacBio HiFi WGS" guarantees the container, not the tags.

set -uo pipefail
: "${SP:?set -v SP=<label>}"; : "${RUN:?set -v RUN=<accession>}"
: "${ACC:?set -v ACC=<assembly>}"; : "${BAM:?set -v BAM=<submitted bam name>}"
ROOT=/work/cyberomics/lep_meth
M=$ROOT/$SP
URL="https://ftp.sra.ebi.ac.uk/vol1/run/${RUN:0:6}/${RUN}/${BAM}"
export PATH=$ROOT/env2/bin:$PATH
SAM=/work/cyberomics/direct_methylation/env/bin/samtools   # the libcurl build
mkdir -p "$M/logs" "$M/bam" "$M/annot"
cd "$M"
echo "=== $SP / $RUN / $ACC"

echo "=== $(date) remote tag check, before any download"
"$SAM" view -H "$URL" 2>/dev/null | grep -E "^@PG" | grep -oE "ID:[a-z0-9]+|VN:[0-9.]+" | tr '\n' ' '; echo
# An MM tag holds SEVERAL specs in one field, semicolon separated, e.g.
# "MM:Z:A+a.,0,111,...;C+m?,3,0,...". Matching on the MM:Z: prefix therefore
# sees only the FIRST spec. On 2026-09-16 that rejected ERR17229027 as having
# no 5mC when every read carried A+a, C+m and T-a: the 6mA was simply listed
# first. Strip the prefix and split on ';' before matching, which is the same
# "slice by MM code" discipline the analysis uses, applied to the check.
NCODE=$("$SAM" view "$URL" 2>/dev/null | head -1000 \
        | grep -oE 'MM:Z:[^[:space:]]+' | sed 's/MM:Z://' | tr ';' '\n' \
        | grep -oE '^[A-Z][+-][a-z0-9]+' | sort | uniq -c | tr '\n' ';')
echo "MM codes in the first 1000 reads: ${NCODE:-NONE}"
case "$NCODE" in
  *"C+m"*) echo "  5mC calls present" ;;
  *) echo "FATAL: no C+m tags in $RUN -- not a methylome, refusing to download"; exit 1 ;;
esac
case "$NCODE" in
  *"C+a"*) echo "  WARNING: C+a (6mA) present alongside 5mC -- slice by MM code downstream" ;;
esac

echo "=== $(date) reference $ACC"
[ -s "$M/annot/$SP.fa" ] || bash "$ROOT/pipeline/scripts/fetch_assembly.sh" "$ACC" "$M/annot/$SP.fa"
"$SAM" faidx "$M/annot/$SP.fa"
FA=$M/annot/$SP.fa
echo "assembly: $(awk '{n++; b+=$2} END{printf "%d sequences, %.1f Mb\n", n, b/1e6}' "$FA.fai")"
MT=$(grep "^>" "$FA" | grep -i -m1 -E 'organelle: *mitochondrion|mitochondrion' | sed 's/^>//' | awk '{print $1}')
echo "mitogenome: ${MT:-NONE FOUND}"
[ -n "$MT" ] || echo "note: no mitogenome in this assembly; the platform-constant sanity check is unavailable (it was never a floor: see the block below)"

echo "=== $(date) fetching $RUN"
RAW=$M/bam/$RUN.hifi.bam
if [ ! -s "$RAW" ]; then
    for i in 1 2 3 4 5; do
        curl -fsSL -C - --retry 5 --retry-delay 20 --retry-all-errors -o "$RAW.part" "$URL" && break || true
    done
    [ -s "$RAW.part" ] || { echo "FATAL: download failed"; exit 1; }
    mv "$RAW.part" "$RAW"
fi
ls -la "$RAW"

echo "=== $(date) pbmm2 align"
ALN=$M/bam/$SP.aln.bam
# pbmm2 validates the output extension and refuses ".bam.part"; the scratch
# name must end in .bam. That cost a job on 2026-09-11.
TMP=$M/bam/$SP.aln.tmp.bam
if [ ! -s "$ALN" ]; then
    rm -f "$TMP"
    pbmm2 align "$FA" "$RAW" "$TMP" --preset HIFI --sort -j 32 --log-level INFO \
        || { echo "FATAL: pbmm2 align failed"; exit 1; }
    [ -s "$TMP" ] || { echo "FATAL: pbmm2 produced no output"; exit 1; }
    mv "$TMP" "$ALN"; samtools index -@ 32 "$ALN"
fi
[ -s "$ALN.bai" ] || samtools index -@ 32 "$ALN"
# same trap: C+m may not be the first spec in the tag
NMM=$(samtools view "$ALN" 2>/dev/null | head -500 \
      | grep -oE 'MM:Z:[^[:space:]]+' | sed 's/MM:Z://' | tr ';' '\n' \
      | grep -cE '^C\+m' || true)
echo "aligned reads carrying MM:Z:C+m in the first 500: ${NMM:-0}"
[ "${NMM:-0}" -ge 400 ] || { echo "FATAL: aligned BAM exists but carries no 5mC tags -- pbmm2 dropped MM/ML"; exit 1; }

echo "=== $(date) CpG scores"
BED=$M/$SP.combined.bed.gz
[ -s "$BED" ] || aligned_bam_to_cpg_scores --bam "$ALN" --ref "$FA" \
    --output-prefix "$M/$SP" --threads 16 --modsites-mode reference
NROWS=$(zcat "$BED" | grep -vc '^#' || true)
[ "${NROWS:-0}" -ge 1000 ] || { echo "FATAL: CpG bed has only ${NROWS:-0} rows"; exit 1; }

echo
echo "============== ${SP^^} METHYLOME =============="
zcat "$BED" | grep -v '^#' | awk -v M="$MT" '
    { n++; s+=$4; c+=$6; if ($4>=50) hi++
      b=int($4/10); if (b>9) b=9; h[b]++
      if ($1==M) { mn++; ms+=$4; mc+=$6 } }
    END {
      printf "genome : sites=%d mean=%.2f%% cov=%.1f pct>=50=%.2f%%\n", n, s/n, c/n, 100*hi/n
      printf "mito   : CpGs=%d mean=%.3f%% cov=%.0f  [REPORTED APART, NOT A FLOOR]\n", mn, (mn? ms/mn : -1), (mn? mc/mn : 0)
      print  "  The mitochondrion fails as a control and this project established"
      print  "  that before it was used here (manuscript_paper1_gr.md): ~78-208 CpGs"
      print  "  in insects, so one false positive moves it 0.5-1.3%, and it"
      print  "  supports an upper bound of ~1% but cannot supply a floor. The"
      print  "  ~3.030% +/- 0.100 seen across 24 species IS the per-read"
      print  "  base-modification error rate of this chemistry, a platform"
      print  "  constant, not a per-genome measurement. A reading near 3.03% here"
      print  "  therefore says the calling behaved normally and says nothing about"
      print  "  how methylated this genome is. Do NOT subtract it from the genome"
      print  "  mean: that differences a site-level statistic against a read-level"
      print  "  constant. The floor is measured by caddis_floor.pbs, banded."
      print  "per-site distribution (BIMODAL = real signal, unimodal = failure):"
      for (i=0;i<10;i++) printf "  %3d-%3d%%: %6.2f%%\n", i*10, i*10+9, 100*h[i]/n
      print  ""
      print  ""
      print  "THE GATE is NOT this pct>=50 figure. >=50 unbanded is the"
      print  "conventional threshold this project measured as 2.2-2.5x worse"
      print  "than >=70, and a genome below 30x sits under the reporting band"
      print  "where the floor is highest. Run caddis_floor.pbs and compare the"
      print  "banded >=70 value against: Acidia cognata 0.0759% (unmethylated"
      print  "out-group, the floor), xylo 0.1414%, ilHelArmi9 0.2925%."
    }'
echo "=============================================="
echo "=== $(date) complete"
