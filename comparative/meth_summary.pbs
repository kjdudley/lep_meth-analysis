#!/bin/bash
#PBS -N meth_summ
#PBS -q cpu_batch
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /work/cyberomics/lep_meth/molanna/logs/
#PBS -V
#
#   qsub -v SP=philopotamus pipeline/scripts/meth_summary.pbs
#
# WHY THIS EXISTS, 2026-09-16. caddis_methyl.pbs printed its methylome summary
# inline at the end of a two-hour pipeline. An awk syntax error introduced by
# the 2026-09-15 mitochondrial correction (a literal newline inside a printf
# string) killed the whole END block on job 25400353, so Philopotamus produced
# a complete 17.6M-site bed and an EMPTY summary, and exited 0.
#
# The lesson is structural, not just a typo: a summary that can only be
# produced by re-running the pipeline is a summary you cannot recompute. This
# script derives it from the bed alone, so a reporting bug costs seconds
# instead of two hours, and so the summary can be re-derived if the reporting
# standard changes again.
set -uo pipefail
: "${SP:?set -v SP=<label>}"
ROOT=/work/cyberomics/lep_meth
BED=${BED:-$ROOT/$SP/$SP.combined.bed.gz}
FA=${FA:-$ROOT/$SP/annot/$SP.fa}
[ -s "$BED" ] || { echo "FATAL: no bed at $BED"; exit 1; }

MT=""
[ -s "$FA" ] && MT=$(grep "^>" "$FA" | grep -i -m1 -E 'organelle: *mitochondrion|mitochondrion' | sed 's/^>//' | awk '{print $1}')
echo "bed        : $BED"
echo "mitogenome : ${MT:-none found}"
echo

zcat "$BED" | grep -v '^#' | awk -v M="$MT" -v SP="$SP" '
    { n++; s+=$4; c+=$6; if ($4>=50) hi++
      b=int($4/10); if (b>9) b=9; h[b]++
      if (M!="" && $1==M) { mn++; ms+=$4; mc+=$6 } }
    END {
      if (n==0) { print "FATAL: zero data rows in bed"; exit 1 }
      printf "============== %s METHYLOME ==============\n", toupper(SP)
      printf "genome : sites=%d mean=%.2f%% cov=%.1f pct>=50=%.2f%%\n", n, s/n, c/n, 100*hi/n
      printf "mito   : CpGs=%d mean=%.3f%% cov=%.0f  [REPORTED APART, NOT A FLOOR]\n", mn, (mn? ms/mn : -1), (mn? mc/mn : 0)
      print  "  The mitochondrion fails as a floor: ~78-208 CpGs in insects, so one"
      print  "  false positive moves it 0.5-1.3%. The ~3.030% +/- 0.100 seen across"
      print  "  24 species IS the per-read base-modification error rate of this"
      print  "  chemistry, a platform constant. A reading near 3.03% says the calling"
      print  "  behaved normally and says NOTHING about how methylated this genome is."
      print  "  Do NOT subtract it from the genome mean. The floor is caddis_floor.pbs."
      print  ""
      print  "  ON A 6mA-CARRYING DEPOSIT this reading is also the leakage test:"
      print  "  the mitochondrion is A/T rich, so if 6mA calls were contaminating the"
      print  "  C+m channel the mito mean would sit well ABOVE 3.03%, not at it."
      print  ""
      print  "per-site distribution (BIMODAL = real signal, unimodal = failure):"
      for (i=0;i<10;i++) printf "  %3d-%3d%%: %6.2f%%\n", i*10, i*10+9, 100*h[i]/n
      print  "=============================================="
    }'
echo "=== done $(date)"
